{
  "id": "build", "v": 1, "game": "1.6.47.841.1", "owner": "Equip", "params": ["hero", "slot"],
  "note": "A hero's whole build (5 gear items, the artifact after them): the same steps as equip, run for every item of the plan in the order of BuildPlanner (slots with no filter first, the set groups after, the artifact last). The budgets are the norms of docs/specs/2026-11-04-shortest-paths.md: hero 8 s, filter 4 s, one item 6 s (twice on a slow PC); past them the step is reset with its diagnosis, never repeated blind. The filter step runs only when the cost model asks for it (more than three drags away, a hidden item); the list flags that hide an item are cleared once for the build.",
  "steps": [
    { "id": "heroes", "key": "graph:hero", "why": "city: Heroes", "from": "Form_MainCity", "widget": "BottomPanel/Image/m_Down_Layout/m_Button_Heros", "target": "EquipNav", "fallback": "geo:hero.heroesBtn",
      "need": "pic:heroesButton", "expect": { "form": "Form_CharactorMain" } },
    { "id": "listClosed", "key": "facet:listClosed", "why": "hero: close the gear list", "from": "Form_CharactorMain", "when": "Hero!=$hero && HeroSlot>=0", "widget": "std:back", "target": "EquipNav", "fallback": "std:back",
      "expect": { "facet": "HeroSlot<0" } },
    { "id": "hero", "from": "Form_CharactorMain", "action": "hero.select", "keep": ["panel:heroFilter"], "budgetMs": 8000, "expect": { "facet": "Hero==$hero" } },
    { "id": "gearTab", "key": "facet:gearTab", "why": "hero: gear tab", "from": "Form_CharactorMain", "widget": "m_Main_Frame/m_Right/m_ToggleGroup/m_Toggle_Equip", "target": "EquipNav", "fallback": "geo:hero.gearTab",
      "expect": { "facet": "HeroTab==gear" } },
    { "id": "slot", "key": "facet:slot", "why": "hero: slot", "from": "Form_CharactorMain", "when": "$slot>=0", "target": "EquipNav", "fallback": "geo:hero.slot($slot)",
      "expect": { "facet": "HeroSlot==$slot" } },
    { "id": "filter", "from": "Form_CharactorMain", "action": "gear.filter", "keep": ["Form_EquipFilterWidget", "panel:gearFilter", "panel:gearSide", "Form_ArtifactFilter"],
      "budgetMs": 4000, "expect": { "action": "done" } },
    { "id": "pick", "from": "Form_CharactorMain", "action": "gear.pick",
      "keep": ["Form_EquipFilterWidget", "panel:gearFilter", "panel:gearSide", "Form_ArtifactFilter", "Form_CharactorEquipTip", "Form_EquipedCompared", "Form_EquipPopUp", "Form_EquipSellPopup"],
      "budgetMs": 6000, "expect": { "action": "done" } }
  ]
}
